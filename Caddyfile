{
    # FrankenPHP classic-mode tuning for long-running Telegram streams.
    # Keep spare PHP threads available so active video streams do not block
    # dashboard/catalog requests or a second stream.
    frankenphp {
        num_threads 6
        max_threads 8
        {$FRANKENPHP_CONFIG}
    }

    # Video streaming writes the response while the request remains open.
    # Allow the HTTP/1 connection to read/write concurrently.
    servers {
        enable_full_duplex
    }

    {$CADDY_GLOBAL_OPTIONS}

    skip_install_trust
}

:8088 {
    root * .

    encode zstd br gzip

    php_server {
        index index.php
    }

    file_server
}

import Caddyfile.d/*.caddyfile
