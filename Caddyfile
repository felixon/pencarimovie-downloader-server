{
    # FrankenPHP configuration for long-running Telegram video streams.
    # Keep enough PHP threads available so active streams do not block
    # normal dashboard/catalog requests or additional streams.
    frankenphp {
        num_threads 8
        max_threads 12
        max_wait_time 10s
        {$FRANKENPHP_CONFIG}
    }

    # Video streaming writes the response while the request remains open.
    # Full-duplex HTTP/1 support prevents the HTTP connection from becoming
    # a bottleneck for long-lived browser streams.
    servers {
        enable_full_duplex
    }

    # Allow extra global Caddy options supplied by the environment.
    {$CADDY_GLOBAL_OPTIONS}

    skip_install_trust
}

:8088 {
    root * .

    encode zstd br gzip

    php_server {
        index index.php
    }

    file_server
}

import Caddyfile.d/*.caddyfile
